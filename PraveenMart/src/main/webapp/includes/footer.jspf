<%@ page pageEncoding="UTF-8" %>
<footer class="site-footer">
    <div class="container">
        <div class="footer-content">
            <div style="display: flex; align-items: center; gap: 1.5rem;">
                <div class="font-headline" style="font-size: 2.1rem; font-weight: 800; color: #0d4722;">PraveenMart</div>
                <div style="font-size: 0.88rem; color: var(--color-on-surface-variant);">
                    &copy; <%= java.time.Year.now().getValue() %> PraveenMart.
                </div>
            </div>

            <div class="footer-links">
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>
                <a href="#">Shipping & Returns</a>
                <a href="#">Contact Us</a>
            </div>
        </div>
    </div>
</footer>

<!-- AI Chatbot Floating Widget (Section 11 & 17) -->
<div id="ai-chat-container">
    <!-- Floating Trigger Button -->
    <button id="ai-chat-toggle" class="ai-chat-btn" aria-label="Open AI Shopping Assistant">
        <span class="material-symbols-outlined ai-chat-icon-open">smart_toy</span>
        <span class="material-symbols-outlined ai-chat-icon-close" style="display: none;">close</span>
        <span class="ai-chat-badge">AI</span>
    </button>

    <!-- Chat Slide-out Panel -->
    <div id="ai-chat-panel" class="ai-chat-panel" style="display: none;">
        <div class="ai-chat-header">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <div class="ai-avatar-icon">
                    <span class="material-symbols-outlined" style="font-size: 1.3rem; color: #fff;">smart_toy</span>
                </div>
                <div>
                    <div style="font-weight: 700; font-size: 0.95rem; color: #fff;">PraveenMart AI</div>
                    <div style="font-size: 0.75rem; color: #a7f3d0; display: flex; align-items: center; gap: 4px;">
                        <span style="width: 7px; height: 7px; background: #34d399; border-radius: 50%; display: inline-block;"></span> Online Assistant
                    </div>
                </div>
            </div>
            <button id="ai-chat-close-btn" class="ai-header-close" aria-label="Close chat">
                <span class="material-symbols-outlined" style="font-size: 1.2rem;">close</span>
            </button>
        </div>

        <div id="ai-chat-messages" class="ai-chat-messages">
            <div class="ai-msg ai-msg-bot">
                <div class="ai-msg-bubble">
                    Hello! I'm your PraveenMart Shopping Assistant. How can I help you with products, orders, shipping, or selling today?
                </div>
            </div>

            <div class="ai-suggestions-title">Suggested questions:</div>
            <div class="ai-suggestions">
                <button type="button" class="ai-chip" onclick="sendSuggestedMessage('How long does shipping take?')">Shipping times?</button>
                <button type="button" class="ai-chip" onclick="sendSuggestedMessage('What is your return policy?')">Return policy</button>
                <button type="button" class="ai-chip" onclick="sendSuggestedMessage('How do I track my order?')">Track order</button>
                <button type="button" class="ai-chip" onclick="sendSuggestedMessage('How can I become a seller?')">Become a seller</button>
                <button type="button" class="ai-chip" onclick="sendSuggestedMessage('What payment methods are supported?')">Payment methods</button>
            </div>
        </div>

        <div class="ai-chat-input-area">
            <form id="ai-chat-form" onsubmit="handleChatSubmit(event)" style="display: flex; gap: 0.5rem; width: 100%;">
                <input type="text" id="ai-chat-input" placeholder="Ask about shipping, orders, returns..." autocomplete="off" maxlength="500" required>
                <button type="submit" id="ai-chat-send-btn" aria-label="Send message">
                    <span class="material-symbols-outlined" style="font-size: 1.2rem;">send</span>
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    #ai-chat-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        font-family: inherit;
    }

    .ai-chat-btn {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d4722, #1b8a48);
        color: white;
        border: none;
        box-shadow: 0 8px 24px rgba(13, 71, 34, 0.35);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .ai-chat-btn:hover {
        transform: scale(1.08);
        box-shadow: 0 12px 30px rgba(13, 71, 34, 0.45);
    }

    .ai-chat-badge {
        position: absolute;
        top: -3px;
        right: -3px;
        background-color: #f59e0b;
        color: #000;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 2px 6px;
        border-radius: 999px;
        border: 2px solid #fff;
    }

    .ai-chat-panel {
        position: absolute;
        bottom: 74px;
        right: 0;
        width: 360px;
        height: 490px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 16px 40px rgba(0,0,0,0.18);
        border: 1px solid rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: aiPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes aiPop {
        from { opacity: 0; transform: translateY(16px) scale(0.96); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @media (max-width: 440px) {
        .ai-chat-panel {
            width: calc(100vw - 32px);
            right: -8px;
            height: 80vh;
        }
    }

    .ai-chat-header {
        background: linear-gradient(135deg, #0d4722, #1b8a48);
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ai-avatar-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ai-header-close {
        background: transparent;
        border: none;
        color: #fff;
        opacity: 0.8;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .ai-header-close:hover { opacity: 1; }

    .ai-chat-messages {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: #f8fafc;
    }

    .ai-msg {
        display: flex;
        max-width: 85%;
    }

    .ai-msg-bot { align-self: flex-start; }
    .ai-msg-user { align-self: flex-end; }

    .ai-msg-bubble {
        padding: 10px 14px;
        border-radius: 14px;
        font-size: 0.88rem;
        line-height: 1.45;
    }

    .ai-msg-bot .ai-msg-bubble {
        background: #ffffff;
        color: #1e293b;
        border: 1px solid #e2e8f0;
        border-bottom-left-radius: 4px;
    }

    .ai-msg-user .ai-msg-bubble {
        background: #0d4722;
        color: #ffffff;
        border-bottom-right-radius: 4px;
    }

    .ai-suggestions-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 6px;
    }

    .ai-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .ai-chip {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        color: #0f172a;
        font-size: 0.78rem;
        padding: 5px 10px;
        border-radius: 999px;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
    }

    .ai-chip:hover {
        background: #e2e8f0;
        border-color: #94a3b8;
    }

    .ai-chat-input-area {
        padding: 10px 14px;
        background: #ffffff;
        border-top: 1px solid #e2e8f0;
    }

    #ai-chat-input {
        flex: 1;
        padding: 9px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 20px;
        font-size: 0.88rem;
        outline: none;
    }

    #ai-chat-input:focus {
        border-color: #0d4722;
    }

    #ai-chat-send-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #0d4722;
        color: #fff;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

    #ai-chat-send-btn:hover {
        background: #15803d;
    }

    .ai-typing-dots {
        display: flex;
        gap: 4px;
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        border-bottom-left-radius: 4px;
        width: fit-content;
    }

    .ai-dot {
        width: 6px;
        height: 6px;
        background: #94a3b8;
        border-radius: 50%;
        animation: aiBounce 1.4s infinite ease-in-out both;
    }
    .ai-dot:nth-child(1) { animation-delay: -0.32s; }
    .ai-dot:nth-child(2) { animation-delay: -0.16s; }

    @keyframes aiBounce {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }
</style>

<script>
    (function() {
        const toggleBtn = document.getElementById('ai-chat-toggle');
        const chatPanel = document.getElementById('ai-chat-panel');
        const closeBtn = document.getElementById('ai-chat-close-btn');
        const iconOpen = toggleBtn.querySelector('.ai-chat-icon-open');
        const iconClose = toggleBtn.querySelector('.ai-chat-icon-close');
        const chatInput = document.getElementById('ai-chat-input');
        const messagesContainer = document.getElementById('ai-chat-messages');

        function toggleChat() {
            const isOpen = chatPanel.style.display !== 'none';
            if (isOpen) {
                chatPanel.style.display = 'none';
                iconOpen.style.display = 'inline-block';
                iconClose.style.display = 'none';
            } else {
                chatPanel.style.display = 'flex';
                iconOpen.style.display = 'none';
                iconClose.style.display = 'inline-block';
                setTimeout(() => chatInput.focus(), 150);
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }
        }

        toggleBtn.addEventListener('click', toggleChat);
        closeBtn.addEventListener('click', toggleChat);

        window.sendSuggestedMessage = function(text) {
            chatInput.value = text;
            handleChatSubmit(new Event('submit'));
        };

        window.handleChatSubmit = function(e) {
            if (e) e.preventDefault();
            const text = chatInput.value.trim();
            if (!text) return;

            appendMessage('user', text);
            chatInput.value = '';

            const typingEl = appendTypingIndicator();

            fetch('<%= request.getContextPath() %>/api/v1/chat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ message: text })
            })
            .then(res => {
                if (res.status === 429) {
                    throw new Error("You're sending messages too fast. Please wait a minute!");
                }
                return res.json();
            })
            .then(data => {
                typingEl.remove();
                const reply = (data && data.data && data.data.reply) || data.reply || (data.error && data.error.message) || "How else can I assist you?";
                appendMessage('bot', reply);
            })
            .catch(err => {
                typingEl.remove();
                appendMessage('bot', err.message || "I'm having a little trouble connecting right now. Please try again in a moment!");
            });
        };

        function appendMessage(sender, text) {
            const msgDiv = document.createElement('div');
            msgDiv.className = 'ai-msg ' + (sender === 'user' ? 'ai-msg-user' : 'ai-msg-bot');
            const bubble = document.createElement('div');
            bubble.className = 'ai-msg-bubble';
            bubble.textContent = text;
            msgDiv.appendChild(bubble);
            messagesContainer.appendChild(msgDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function appendTypingIndicator() {
            const typingDiv = document.createElement('div');
            typingDiv.className = 'ai-msg ai-msg-bot';
            typingDiv.innerHTML = '<div class="ai-typing-dots"><div class="ai-dot"></div><div class="ai-dot"></div><div class="ai-dot"></div></div>';
            messagesContainer.appendChild(typingDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            return typingDiv;
        }
    })();
</script>

<!-- ========================================================================= -->
<!-- Global Cart Pop-Up Frame & AJAX Add to Cart Handler (No Page Reload / Top Jump) -->
<!-- ========================================================================= -->
<style>
    .cart-popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .cart-popup-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .cart-popup-frame {
        background: #ffffff;
        border-radius: 20px;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        transform: scale(0.92) translateY(12px);
        transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .cart-popup-overlay.active .cart-popup-frame {
        transform: scale(1) translateY(0);
    }

    .cart-popup-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.15rem 1.4rem;
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        border-bottom: 1px solid #a7f3d0;
    }

    .cart-popup-badge-success {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        color: #065f46;
    }

    .cart-popup-close-btn {
        background: transparent;
        border: none;
        font-size: 1.6rem;
        color: #065f46;
        cursor: pointer;
        line-height: 1;
        padding: 0.15rem 0.45rem;
        border-radius: 8px;
        transition: background-color 0.15s ease;
    }

    .cart-popup-close-btn:hover {
        background-color: rgba(6, 95, 70, 0.14);
    }

    .cart-popup-body {
        padding: 1.35rem 1.4rem;
    }

    .cart-popup-product-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 0.95rem;
    }

    .cart-popup-img-wrap {
        width: 76px;
        height: 76px;
        border-radius: 10px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        flex-shrink: 0;
    }

    .cart-popup-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cart-popup-info {
        flex: 1;
        min-width: 0;
    }

    .cart-popup-category {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-primary);
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .cart-popup-name {
        font-weight: 700;
        font-size: 1rem;
        color: #0f172a;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.45rem;
    }

    .cart-popup-meta-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .cart-popup-price-val {
        font-weight: 800;
        font-size: 1.1rem;
        color: #0d4722;
    }

    .cart-popup-qty-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #e0f2fe;
        color: #0369a1;
        font-size: 0.82rem;
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
        font-weight: 600;
        border: 1px solid #bae6fd;
    }

    .cart-popup-qty-pill strong {
        font-weight: 800;
        font-size: 0.9rem;
    }

    .cart-popup-summary-box {
        margin-top: 1.1rem;
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 0.9rem 1.1rem;
    }

    .cart-popup-actions {
        display: flex;
        gap: 0.75rem;
        padding: 1.1rem 1.4rem;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    /* Stepper widget for any card or details page */
    .card-qty-stepper {
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--color-outline-variant);
        border-radius: var(--radius-pill);
        background: var(--color-surface-container);
        overflow: hidden;
        height: 32px;
    }

    .card-qty-stepper .qty-btn {
        background: transparent;
        border: none;
        width: 26px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-on-surface);
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
        user-select: none;
        padding: 0;
    }

    .card-qty-stepper .qty-btn:hover {
        background: rgba(13, 71, 34, 0.12);
        color: var(--color-primary);
    }

    .card-qty-stepper .qty-btn:active {
        transform: scale(0.92);
    }

    .card-qty-stepper .qty-input-field {
        width: 26px;
        border: none;
        background: transparent;
        text-align: center;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-on-surface);
        -moz-appearance: textfield;
        padding: 0;
        pointer-events: none;
    }

    .card-qty-stepper .qty-input-field::-webkit-outer-spin-button,
    .card-qty-stepper .qty-input-field::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>

<div id="cart-popup-overlay" class="cart-popup-overlay" aria-hidden="true">
    <div class="cart-popup-frame" role="dialog" aria-modal="true" aria-labelledby="cart-popup-title">
        <div class="cart-popup-header">
            <div class="cart-popup-badge-success" id="cart-popup-status-badge">
                <span class="material-symbols-outlined" id="cart-popup-icon" style="font-size: 1.5rem; color: #059669;">check_circle</span>
                <span id="cart-popup-title" style="font-weight: 700; font-size: 1.05rem; color: #065f46;">Product Added to Cart!</span>
            </div>
            <button type="button" class="cart-popup-close-btn" id="cart-popup-close-btn" aria-label="Close pop-up">&times;</button>
        </div>

        <div class="cart-popup-body">
            <div class="cart-popup-product-card" id="cart-popup-product-card">
                <div class="cart-popup-img-wrap">
                    <img id="cart-popup-img" src="" alt="Product" onerror="this.src='https://images.unsplash.com/photo-1544816155-12df9643f363?w=600&auto=format&fit=crop&q=80'">
                </div>
                <div class="cart-popup-info">
                    <div id="cart-popup-category" class="cart-popup-category"></div>
                    <div id="cart-popup-name" class="cart-popup-name"></div>
                    <div class="cart-popup-meta-row">
                        <div class="cart-popup-price-val" id="cart-popup-price"></div>
                        <div class="cart-popup-qty-pill">
                            <span>Quantity:</span>
                            <strong id="cart-popup-qty">1</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cart-popup-summary-box" id="cart-popup-summary-box">
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.9rem;">
                    <span style="color: var(--color-on-surface-variant);">Total Items in Cart:</span>
                    <strong id="cart-popup-total-items" style="color: var(--color-on-surface); font-weight: 700;">1 item</strong>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 1.05rem; margin-top: 0.45rem; font-weight: 800;">
                    <span>Cart Subtotal:</span>
                    <span id="cart-popup-subtotal" style="color: #0d4722;">₹0.00</span>
                </div>
            </div>

            <div id="cart-popup-msg-box" style="display: none; padding: 1.25rem 0.5rem; text-align: center;">
                <p id="cart-popup-msg-text" style="font-size: 1rem; color: #334155; margin-bottom: 0.5rem;"></p>
            </div>
        </div>

        <div class="cart-popup-actions" id="cart-popup-actions">
            <button type="button" class="btn btn-secondary btn-pill" id="cart-popup-continue-btn" style="flex: 1; padding: 0.75rem 1rem; font-size: 0.92rem;">
                <span>Continue Shopping</span>
            </button>
            <a href="<%= request.getContextPath() %>/cart" class="btn btn-primary btn-pill" id="cart-popup-primary-btn" style="flex: 1; padding: 0.75rem 1rem; font-size: 0.92rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; text-decoration: none;">
                <span class="material-symbols-outlined" style="font-size: 1.15rem;">shopping_cart</span>
                <span id="cart-popup-primary-text">View Cart</span>
            </a>
        </div>
    </div>
</div>

<script>
    (function() {
        const overlay = document.getElementById('cart-popup-overlay');
        const closeBtn = document.getElementById('cart-popup-close-btn');
        const continueBtn = document.getElementById('cart-popup-continue-btn');
        const imgEl = document.getElementById('cart-popup-img');
        const nameEl = document.getElementById('cart-popup-name');
        const catEl = document.getElementById('cart-popup-category');
        const priceEl = document.getElementById('cart-popup-price');
        const qtyEl = document.getElementById('cart-popup-qty');
        const totalItemsEl = document.getElementById('cart-popup-total-items');
        const subtotalEl = document.getElementById('cart-popup-subtotal');
        const productCard = document.getElementById('cart-popup-product-card');
        const summaryBox = document.getElementById('cart-popup-summary-box');
        const msgBox = document.getElementById('cart-popup-msg-box');
        const msgText = document.getElementById('cart-popup-msg-text');
        const primaryBtn = document.getElementById('cart-popup-primary-btn');
        const primaryText = document.getElementById('cart-popup-primary-text');
        const titleEl = document.getElementById('cart-popup-title');
        const iconEl = document.getElementById('cart-popup-icon');

        function formatInr(num) {
            if (typeof num !== 'number') {
                num = parseFloat(num) || 0;
            }
            return '₹' + num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function closeCartPopup() {
            if (overlay) {
                overlay.classList.remove('active');
                overlay.setAttribute('aria-hidden', 'true');
            }
        }

        if (closeBtn) closeBtn.addEventListener('click', closeCartPopup);
        if (continueBtn) continueBtn.addEventListener('click', closeCartPopup);
        if (overlay) {
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay) closeCartPopup();
            });
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && overlay && overlay.classList.contains('active')) {
                closeCartPopup();
            }
        });

        // Global Quantity Stepper Handler
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.qty-btn');
            if (!btn) return;

            const stepper = btn.closest('.card-qty-stepper');
            if (!stepper) return;

            const input = stepper.querySelector('.qty-input-field');
            if (!input) return;

            let val = parseInt(input.value || '1', 10);
            const min = parseInt(input.getAttribute('min') || '1', 10);
            const max = parseInt(input.getAttribute('max') || '999', 10);

            if (btn.classList.contains('qty-btn-minus')) {
                if (val > min) {
                    input.value = val - 1;
                }
            } else if (btn.classList.contains('qty-btn-plus')) {
                if (val < max) {
                    input.value = val + 1;
                }
            }
        });

        // Global AJAX Add-to-Cart Form Interceptor (Prevents jump to top!)
        document.addEventListener('submit', function(e) {
            const form = e.target.closest('form.add-to-cart-form') || 
                         (e.target.action && e.target.action.includes('/cart/add') ? e.target : null);
            if (!form) return;

            // PREVENT FULL PAGE RELOAD & PREVENT SCROLLING TO TOP!
            e.preventDefault();

            const submitBtn = form.querySelector('button[type="submit"]') || form.querySelector('.btn-add-cart');
            const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem; animation: spin 1s linear infinite;">progress_activity</span> <span>Adding...</span>';
            }

            const formData = new FormData(form);
            const quantityVal = parseInt(formData.get('quantity') || '1', 10);

            // Extract metadata from form data attributes or surrounding markup
            const card = form.closest('.product-card') || form.closest('.product-overview-grid') || document;
            const pName = form.dataset.productName || (card.querySelector('.product-title') ? card.querySelector('.product-title').textContent.trim() : '') || 'Selected Product';
            const pPrice = form.dataset.productPrice || (card.querySelector('.product-price') ? card.querySelector('.product-price').textContent.trim() : '');
            const pCat = form.dataset.productCategory || (card.querySelector('.product-category-tag') ? card.querySelector('.product-category-tag').textContent.trim() : 'Store');
            const imgTarget = card.querySelector('.product-image-box img') || card.querySelector('.details-image-box img');
            const pImg = form.dataset.productImage || (imgTarget ? imgTarget.getAttribute('src') : '');

            fetch(form.action, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: new URLSearchParams(formData)
            })
            .then(res => res.json())
            .then(data => {
                if (data.requireLogin) {
                    // Show Login prompt modal without reloading
                    titleEl.textContent = 'Sign In Required';
                    titleEl.style.color = '#991b1b';
                    iconEl.textContent = 'lock';
                    iconEl.style.color = '#dc2626';
                    productCard.style.display = 'none';
                    summaryBox.style.display = 'none';
                    msgBox.style.display = 'block';
                    msgText.textContent = data.message || 'Please sign in to add items to your shopping cart.';
                    primaryBtn.href = data.redirect || '<%= request.getContextPath() %>/login.jsp';
                    primaryText.textContent = 'Sign In Now';
                    continueBtn.querySelector('span').textContent = 'Cancel';
                    overlay.classList.add('active');
                    overlay.setAttribute('aria-hidden', 'false');
                    return;
                }

                if (data.success) {
                    // Update header nav badge immediately
                    const badge = document.getElementById('navCartBadge');
                    if (badge && data.itemCount !== undefined) {
                        badge.textContent = data.itemCount;
                        badge.style.display = data.itemCount > 0 ? 'flex' : 'none';
                    }

                    // Reset modal to Success State
                    titleEl.textContent = 'Product Added to Cart!';
                    titleEl.style.color = '#065f46';
                    iconEl.textContent = 'check_circle';
                    iconEl.style.color = '#059669';
                    productCard.style.display = 'flex';
                    summaryBox.style.display = 'block';
                    msgBox.style.display = 'none';
                    primaryBtn.href = '<%= request.getContextPath() %>/cart';
                    primaryText.textContent = 'View Cart';
                    continueBtn.querySelector('span').textContent = 'Continue Shopping';

                    // Populate product info & Quantity
                    if (imgEl && pImg) imgEl.src = pImg;
                    if (nameEl) nameEl.textContent = pName;
                    if (catEl) catEl.textContent = pCat;
                    if (priceEl) priceEl.textContent = pPrice;
                    if (qtyEl) qtyEl.textContent = quantityVal;

                    // Populate summary box
                    if (totalItemsEl) {
                        totalItemsEl.textContent = (data.itemCount || 1) + (data.itemCount === 1 ? ' item' : ' items');
                    }
                    if (subtotalEl && data.totalAmount !== undefined) {
                        subtotalEl.textContent = formatInr(data.totalAmount);
                    }

                    // Open pop-up frame modal smoothly
                    overlay.classList.add('active');
                    overlay.setAttribute('aria-hidden', 'false');
                } else {
                    alert(data.message || 'Could not add product to cart.');
                }
            })
            .catch(err => {
                console.error('AJAX add to cart failed:', err);
                alert('An error occurred while adding to cart. Please try again.');
            })
            .finally(() => {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnHtml;
                }
            });
        });
    })();
</script>

